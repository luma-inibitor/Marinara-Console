{
  "name": "marinara-console",
  "version": "1.0.0",
  "scripts": {
    "build": "bun x --bun vite build && bun scripts/precompress.mjs",
    "build-storybook": "bun x --bun storybook build",
    "check": "bun run check:static && bun run check:test && bun run check:build",
    "check:build": "bun run build",
    "check:static": "bun scripts/run-checks.mjs",
    "check:test": "bun x --bun vitest run",
    "components": "bun scripts/components.mjs",
    "copycatalog": "bun scripts/copycatalog.mjs",
    "csslint": "bun x --bun stylelint \"src/**/*.css\"",
    "deadcss": "bun scripts/deadcss.mjs",
    "dev": "bun x --bun vite",
    "docrefs": "bun scripts/docrefs.mjs",
    "domsnap": "bun scripts/domsnap.mjs",
    "format": "bun x --bun prettier --write .",
    "format:check": "bun x --bun prettier --check .",
    "jscpd": "bun x --bun jscpd",
    "kit": "bun x --bun @tailwindcss/cli -i design/mockup-kit.css -o public/mockups/kit.css",
    "knip": "bun x --bun knip",
    "layercheck": "bun scripts/layercheck.mjs",
    "linkcheck": "bun x --bun markdown-link-check -q -c .markdown-link-check.json README.md CLAUDE.md BACKLOG.md design/*.md",
    "lint": "bun x --bun eslint src scripts",
    "pkgcheck": "bun scripts/pkgcheck.mjs",
    "precompress": "bun scripts/precompress.mjs",
    "prepare": "bun scripts/prepare.mjs",
    "preview": "bun x --bun vite preview",
    "prose": "vale --no-global .",
    "prosecheck": "bun scripts/prosecheck.mjs",
    "ratchet": "bun scripts/ratchet.mjs",
    "specificity": "bun scripts/specificity.mjs",
    "storybook": "bun x --bun storybook dev -p 6006 --no-open",
    "test": "bun x --bun vitest run",
    "test:e2e": "bun x --bun playwright test",
    "test:storybook": "bun x --bun vitest run --config vitest.storybook.config.ts",
    "test:watch": "bun x --bun vitest",
    "typecheck": "bun x --bun tsc --noEmit",
    "typecheck:scripts": "bun x --bun tsc -p tsconfig.scripts.json",
    "typescale": "bun scripts/typescale.mjs"
  },
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/parser": "^7.29.8",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "markdown-link-check": "^3.15.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "http-proxy-middleware": "^4.2.0",
    "mrmime": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.4.2"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
