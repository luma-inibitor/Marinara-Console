{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // scripts/layercheck.mjs tells an upward dependency from a type-only one by
    // reading `import type`; this makes the compiler enforce that marking
    // instead of trusting each import's author to remember it.
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["vite/client"]
  },
  // `tests` is here so the browser specs are type-checked with everything
  // else: Playwright transpiles them without checking types, so nothing else
  // would ever read them. playwright.config.ts is deliberately NOT here — it
  // reads `process.env`, and there is no @types/node, so including it would
  // mean putting node globals on the `types` list that src/ compiles against.
  "include": ["src", "tests"]
}
